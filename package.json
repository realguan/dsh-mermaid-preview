{
  "name": "dsh-mermaid-preview",
  "version": "0.3.0",
  "description": "Render Mermaid fenced code blocks as diagrams in every DeepSeek Harness (dsh) Web Markdown surface.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "src",
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "demo",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/serve-demo.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "mermaid",
    "diagram",
    "markdown"
  ],
  "author": "realguan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realguan/dsh-mermaid-preview.git"
  },
  "homepage": "https://github.com/realguan/dsh-mermaid-preview#readme",
  "engines": {
    "node": ">=18"
  }
}
