{
  "name": "dsh-mermaid-preview",
  "version": "0.2.0",
  "description": "Render Mermaid fenced code blocks as diagrams in DeepSeek Harness (dsh) web — chat, trajectory, plan review and every other Markdown surface.",
  "type": "module",
  "main": "src/client.js",
  "exports": {
    ".": "./src/client.js",
    "./client": "./src/client.js",
    "./dynamic": "./dist/dsh-mermaid-preview.client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "dist",
    "cordis.yml",
    "demo",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build-dynamic.mjs",
    "check": "node --check src/client.js && node --check dist/dsh-mermaid-preview.client.js && node scripts/build-dynamic.mjs --verify",
    "demo": "node scripts/serve-demo.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "mermaid",
    "diagram",
    "markdown"
  ],
  "author": "realguan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realguan/dsh-mermaid-preview.git"
  },
  "homepage": "https://github.com/realguan/dsh-mermaid-preview#readme",
  "engines": {
    "node": ">=18"
  }
}
